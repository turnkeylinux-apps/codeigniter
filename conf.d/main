#!/bin/bash
set -Eeuo pipefail

DB_NAME=codeigniter
DB_USER=codeigniter
DB_PASS=$(mcookie)

SRC=/usr/local/src
WEBROOT=/var/www/codeigniter
CI=/var/local/codeigniter
VERSION=4.7.4
TAG=v4.7.4
COMMIT=2bd0f01d2813f9ec06db42643ce39d9f5428bf6d
ARCHIVE_SHA256=a28cf27e2fc0c7220b6212fa16aa396bf8bd1ad7150d996db1acfd39dee47e77
ARCHIVE="$SRC/codeigniter-v${VERSION}.zip"

# unpack and configure
unzip -q "$ARCHIVE" -d "$SRC"
test -d "$SRC/CodeIgniter4-$VERSION"
mv "$SRC/CodeIgniter4-$VERSION" "$WEBROOT"
rm "$ARCHIVE"
chown -R root:root "$WEBROOT"

mkdir -p "$CI"
mv "$WEBROOT/app" "$CI"
mv "$WEBROOT/system" "$CI"
mv "$WEBROOT/writable" "$CI"
mv "$WEBROOT/env" "$CI/.env"

CONF=$CI/app/Views/welcome_message.php
sed -i 's|app/Views|/var/local/codeigniter/app/Views|' "$CONF"
sed -i 's|app/Controllers|/var/local/codeigniter/app/Controllers|' "$CONF"
sed -i '/CONTENT -->/,/<div/ s|</section>|<?php include __DIR__ . "/_tkl_include.php"; ?></section>|' "$CONF"

mkdir -p "$WEBROOT/public/assets"

cp -TdR "$SRC/codeigniter.overlay" "$CI"
rm -rf "$SRC/codeigniter.overlay"

# The web and CLI entry points remain in the document-root tree while the
# application and framework code live outside it.
for CONF in "$WEBROOT/public/index.php" "$WEBROOT/spark"; do
    sed -i 's|^require FCPATH \. .*Paths\.php.*|require "/var/local/codeigniter/app/Config/Paths.php";|' "$CONF"
    grep -Fxq 'require "/var/local/codeigniter/app/Config/Paths.php";' "$CONF"
done

install -d /usr/local/share/turnkey
cat > /usr/local/share/turnkey/codeigniter-release <<EOF
VERSION=$VERSION
TAG=$TAG
COMMIT=$COMMIT
ARCHIVE_SHA256=$ARCHIVE_SHA256
SOURCE_URL=https://github.com/codeigniter4/CodeIgniter4
EOF

# configure apache
a2dissite 000-default
a2ensite codeigniter
a2enmod rewrite

# setup the database
service mysql start

mysql --batch --execute "CREATE DATABASE $DB_NAME"
mysql --batch --execute "CREATE USER '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASS'; GRANT ALL PRIVILEGES ON $DB_NAME.* TO '$DB_USER'@'localhost'; FLUSH PRIVILEGES;"

CONF=$CI/app/Config/Database.php
sed -i "/public array \$default = \[/,/    \];/ s|'username'     => .*|'username'     => '$DB_USER',|" "$CONF"
sed -i "/public array \$default = \[/,/    \];/ s|'password'     => .*|'password'     => '$DB_PASS',|" "$CONF"
sed -i "/public array \$default = \[/,/    \];/ s|'database'     => .*|'database'     => '$DB_NAME',|" "$CONF"

service mysql stop

# misc tweak and secure configuration files from prying eyes
CONF=$CI/app/Config/Encryption.php
sed -i "s|public string \$key = .*|public string \$key = '$(mcookie)';|" "$CONF"

chown -R www-data:www-data "$CI/app/Config"
chmod 640 "$CI"/app/Config/*.php
chown -R www-data:www-data "$CI/writable"
