#!/bin/bash
set -Eeuo pipefail

VERSION=4.7.4
URL="https://github.com/codeigniter4/CodeIgniter4/archive/refs/tags/v${VERSION}.zip"
SHA256=a28cf27e2fc0c7220b6212fa16aa396bf8bd1ad7150d996db1acfd39dee47e77
ARCHIVE="/usr/local/src/codeigniter-v${VERSION}.zip"
curl_args=(--location --fail --show-error)

if [[ -n ${FAB_HTTP_PROXY:-} ]]; then
    curl_args+=(--proxy "$FAB_HTTP_PROXY")
fi

curl "${curl_args[@]}" "$URL" --output "$ARCHIVE"
printf '%s  %s\n' "$SHA256" "$ARCHIVE" | sha256sum --check --strict
